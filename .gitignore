node_modules
.next
.next-check
out
.env*
!.env.example
*.tsbuildinfo
next-env.d.ts.bak

# the raw source drop — huge originals, not part of the build
imgss/

# working notes for the client — screenshots and screen recordings, not source
change/

# stray debug dumps from local harnesses
out*.html

# stray probe screenshots must never land in the repo
/cloud-w*.png
/hero-now.png

# harness screenshots — the .mjs probes in scratchpad/ are worth keeping,
# the pictures they produce are not
scratchpad/*.png
# …and the same for the other shapes a probe emits: crops, previews, server
# logs, and the intermediate row/match manifests whose contents are merged
# into lib/products.json (the pipeline that writes them is the .mjs beside
# them, which IS kept)
scratchpad/*.jpg
scratchpad/*.log
scratchpad/*-rows.json
scratchpad/*-match.json
