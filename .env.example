# Copy to .env.local and fill in before launch.

# The public origin. Until this is an https URL, robots.txt blocks all indexing.
NEXT_PUBLIC_SITE_URL=

# Order + enquiry delivery. With NEITHER set, both endpoints still accept the
# submission, log it to the server console, and return delivered:false — the UI
# then tells the visitor honestly and offers the email address instead.
ORDER_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
RESEND_API_KEY=
ORDER_TO_EMAIL=