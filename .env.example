# Copy to .env.local and fill in before launch.

# The public origin. Until this is an https URL, robots.txt blocks all indexing.
NEXT_PUBLIC_SITE_URL=

# Order + enquiry delivery. With NEITHER set, both endpoints still accept the
# submission, log it to the server console, and return delivered:false — the UI
# then tells the visitor honestly and offers the email address instead.
ORDER_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
RESEND_API_KEY=
ORDER_TO_EMAIL=
# The Resend SENDER for the contact form (2026-10-12). Unset, the form sends
# as "ArpenArt <onboarding@resend.dev>" — and Resend delivers mail from that
# onboarding address ONLY to the address that owns the Resend account, so
# with ORDER_TO_EMAIL=arpenbaroyan@gmail.com nothing arrives unless the
# account is hers. For delivery to her inbox from any account, verify a
# domain in Resend and set a sender on it, e.g. "ArpenArt <contact@arpenart.com>".
CONTACT_FROM=
# Sign-in. A random secret at least 16 characters long; magic-link tokens
# and session cookies are signed with it. Unset, the sign-in screen says so
# and refuses to issue links rather than falling back to a guessable key.
AUTH_SECRET=
