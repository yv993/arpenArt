# Copy to .env.local for local work; on Vercel, set the same names under
# Settings → Environment Variables (Production). EVERY variable is optional:
# absent = that feature is off and the site still works and says so honestly.
# NEVER commit real values. Rows marked SECRET must stay out of git, chats and
# screenshots. Any change on Vercel needs a REDEPLOY before it takes effect.
# The full table and the launch order are in README.md and docs/LAUNCH-CHECKLIST.md.

# --- the public address --------------------------------------------------------
# The public origin, e.g. https://www.arpenart.com (https, lowercase, no slash at
# the end). Until it is an https URL, robots.txt says Disallow: / and the
# sitemap is empty — setting it is also the "open to Google" switch.
NEXT_PUBLIC_SITE_URL=

# --- where orders and messages go ----------------------------------------------
# Both channels are used when both are configured (not either/or); an order
# counts as delivered when at least one of them accepted it. With neither, the
# routes still accept the submission, write it to the server log and answer
# delivered:false — the page then tells the visitor and shows Arpine's address.
#
# SECRET. Resend API key (resend.com → API Keys). Turns on email delivery.
RESEND_API_KEY=
# Arpine's inbox: where Resend delivers orders and contact messages, and the
# reply-to of the buyer's copy. Unset (webhook only), the copy replies to the
# shop's public address, brand.email in lib/content.ts.
ORDER_TO_EMAIL=
# The ONE sender for all mail (order to Arpine, buyer's copy, contact,
# sign-in), on a domain verified in Resend, e.g. "ArpenArt <shop@arpenart.com>".
# Fallback: CONTACT_FROM, then "ArpenArt <onboarding@resend.dev>" — and the
# onboarding address reaches ONLY the Resend account's own owner, so with it no
# buyer copy is attempted and sign-in stays off. The buyer's copy ALSO needs
# both Turnstile keys below: without the bot check it is never sent.
MAIL_FROM=
# Legacy name for the sender (still honoured when MAIL_FROM is empty).
CONTACT_FROM=
# SECRET (the URL is the credential). Optional HTTPS endpoint that receives
# each order as JSON — e.g. an order log the owner runs. Each post carries an
# Idempotency-Key header; a receiver slower than about 12 seconds gets one
# retry with the same key, so it should skip a key it has already seen.
ORDER_WEBHOOK_URL=
# SECRET (same reason). Optional HTTPS endpoint that receives each contact
# message (same Idempotency-Key header and retry).
CONTACT_WEBHOOK_URL=
# SECRET. When set, both webhooks carry
# "X-ArpenArt-Signature: sha256=<hex HMAC-SHA256 of the exact raw body>",
# so the receiver can prove the request came from this site.
WEBHOOK_SECRET=
# TEST ONLY. Overrides https://api.resend.com so a local mock server can stand
# in for Resend. Leave EMPTY everywhere real, above all on Vercel.
RESEND_API_BASE=

# --- sign-in --------------------------------------------------------------------
# SECRET. A random string of at least 16 characters; sign-in links and the
# ap_session cookie are signed with it. Unset or short, sign-in refuses to run.
AUTH_SECRET=
# NEXT_PUBLIC_SIGNIN is NOT set by hand: next.config.mjs computes it at build
# ("1" only when AUTH_SECRET >= 16 chars AND RESEND_API_KEY is set AND the
# sender above is verified). It decides whether the account icon shows.

# --- bot check (Cloudflare Turnstile) -------------------------------------------
# Public site key: the widget renders on the forms only when this is set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SECRET. The server enforces the check only when this AND the site key are set
# (the secret alone checks nothing). Set BOTH or neither. Both together are also
# what switches on the buyer's copy of an order (/api/health buyerCopy).
TURNSTILE_SECRET_KEY=

# --- search consoles (the verification code only, not the whole meta tag) -------
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
BING_SITE_VERIFICATION=
